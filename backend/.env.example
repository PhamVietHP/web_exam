# Local backend
PORT=5000
NODE_ENV=development

# Chọn chế độ gửi email:
# demo      = không gửi thật, chỉ log terminal
# smtp      = gửi bằng Gmail App Password, dễ nhất cho đồ án
# gmail_api = gửi bằng Gmail API OAuth2
MAIL_MODE=smtp

# SMTP Gmail App Password
# Bật 2-Step Verification trong Gmail rồi tạo App Password 16 ký tự
GMAIL_SENDER_EMAIL=phamvanviet0905@gmail.com
GMAIL_USER=phamvanviet0905@gmail.com
GMAIL_APP_PASSWORD=123

# Google Sign-In / Google Login
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
ALLOW_GOOGLE_AUTO_CREATE_STUDENT=false

# Gmail API OAuth2 nếu dùng MAIL_MODE=gmail_api
GMAIL_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
